# Copy this file to .env and fill in real values. Never commit .env.

# Database (PostgreSQL with the pgvector extension)
DATABASE_URL=postgresql://finlint:finlint@localhost:5432/finlint

# LLM provider (Section 5: Groq or Gemini by default)
GROQ_API_KEY=
GOOGLE_API_KEY=

# Offline fallback (Ollama running locally)
OLLAMA_BASE_URL=http://localhost:11434

# File storage (S3, or leave blank for local dev storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# SEC EDGAR requires a real identifying user agent, see CLAUDE.md Section 6.5
SEC_USER_AGENT="Your Name your-email@example.com"
